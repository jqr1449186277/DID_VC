# Local native development defaults. Override any value in your shell, or set
# DID_E2E_CONFIG to point at another env file.

PROJECT_ROOT="${PROJECT_ROOT:-$HOME/did-e2e}"
CPP_DIR="${CPP_DIR:-$PROJECT_ROOT/cpp}"
HARDHAT_DIR="${HARDHAT_DIR:-$PROJECT_ROOT/hardhat}"
SCRIPTS_DIR="${SCRIPTS_DIR:-$PROJECT_ROOT/scripts}"
BUILD_DIR="${BUILD_DIR:-$PROJECT_ROOT/build}"
RUN_DIR="${RUN_DIR:-$PROJECT_ROOT/run}"
LOG_DIR="${LOG_DIR:-$PROJECT_ROOT/results/_logs}"
RESULTS_DIR="${RESULTS_DIR:-$PROJECT_ROOT/results}"

RPC_URL="${RPC_URL:-http://127.0.0.1:8545}"
BB_PORT="${BB_PORT:-3000}"
BASE_URL="${BASE_URL:-http://127.0.0.1:${BB_PORT}}"
DIDZK_VERIFY_SERVICE_HOST="${DIDZK_VERIFY_SERVICE_HOST:-127.0.0.1}"
DIDZK_VERIFY_SERVICE_PORT="${DIDZK_VERIFY_SERVICE_PORT:-3400}"
DIDZK_VERIFY_SERVICE_URL="${DIDZK_VERIFY_SERVICE_URL:-http://${DIDZK_VERIFY_SERVICE_HOST}:${DIDZK_VERIFY_SERVICE_PORT}/verify}"
DIDZK_VERIFY_SERVICE_HEALTH="${DIDZK_VERIFY_SERVICE_HEALTH:-http://${DIDZK_VERIFY_SERVICE_HOST}:${DIDZK_VERIFY_SERVICE_PORT}/health}"
VERIFY_HOST="${VERIFY_HOST:-$DIDZK_VERIFY_SERVICE_HOST}"
VERIFY_PORT="${VERIFY_PORT:-$DIDZK_VERIFY_SERVICE_PORT}"
VERIFY_URL="${VERIFY_URL:-$DIDZK_VERIFY_SERVICE_URL}"
VERIFY_HEALTH="${VERIFY_HEALTH:-$DIDZK_VERIFY_SERVICE_HEALTH}"
PIRATE_PORT="${PIRATE_PORT:-4000}"
PIRATE_URL="${PIRATE_URL:-http://127.0.0.1:${PIRATE_PORT}}"
COMMITTEE_PORTS="${COMMITTEE_PORTS:-8001 8002 8003 8004 8005 8006}"

TOKEN="${TOKEN:-demo-token}"
TTSS_N="${TTSS_N:-6}"
TTSS_T="${TTSS_T:-4}"
TREE_DEPTH="${TREE_DEPTH:-20}"

WAIT_SEC="${WAIT_SEC:-60}"
TIMEOUT_MS="${TIMEOUT_MS:-5000}"
REGISTER_WAIT_MS="${REGISTER_WAIT_MS:-120000}"
PATH_WAIT_MS="${PATH_WAIT_MS:-120000}"
ROOT_WAIT_MS="${ROOT_WAIT_MS:-60000}"
ROOT_POLL_MS="${ROOT_POLL_MS:-500}"
SMOKE_TTSS_SETUP="${SMOKE_TTSS_SETUP:-1}"
HARDHAT_DEPLOY_COMPILE="${HARDHAT_DEPLOY_COMPILE:-1}"

MAIN_BIN="${MAIN_BIN:-$BUILD_DIR/did_demo_zk}"
COMMITTEE_BIN="${COMMITTEE_BIN:-$BUILD_DIR/committee_node}"
TRACER_JS="${TRACER_JS:-$HARDHAT_DIR/tracer_client.js}"
PIRATE_JS="${PIRATE_JS:-$HARDHAT_DIR/pirate_box.js}"
BB_SERVICE_JS="${BB_SERVICE_JS:-$HARDHAT_DIR/bb_service_zk.js}"
VERIFIER_JS="${VERIFIER_JS:-$SCRIPTS_DIR/zk_verify_service.js}"
DEPLOY_SCRIPT="${DEPLOY_SCRIPT:-scripts/deploy_zk.js}"
ENV_FILE="${ENV_FILE:-$RUN_DIR/ttss_phase5_env.sh}"
SMOKE_STATE_FILE="${SMOKE_STATE_FILE:-$RUN_DIR/ttss_phase5_smoke_last.json}"

NODE_PID_FILE="${NODE_PID_FILE:-$RUN_DIR/hardhat-node.pid}"
SERVICE_PID_FILE="${SERVICE_PID_FILE:-$RUN_DIR/bb_service_zk.pid}"
VERIFIER_PID_FILE="${VERIFIER_PID_FILE:-$RUN_DIR/zk_verify_service.pid}"
PIRATE_PID_FILE="${PIRATE_PID_FILE:-$RUN_DIR/pirate_box.pid}"
COMMITTEE_PID_PREFIX="${COMMITTEE_PID_PREFIX:-$RUN_DIR/committee_node_}"
DEV_LOG_PREFIX="${DEV_LOG_PREFIX:-ttss-phase5-env}"
